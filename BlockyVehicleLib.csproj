      <Compile Remove="Entities\EntityControlledVehiclePhysics.cs" />
      <Compile Remove="Entities\EntityBehaviorPlayerVehiclePhysics.cs" />
      <Compile Remove="Entities\BVLBehaviorVehiclePhysics.cs" />
      <Compile Remove="Util\**" />
      <Compile Remove="Renderer\**" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Remove="Util\**" />
      <EmbeddedResource Remove="Renderer\**" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Util\**" />
      <None Remove="Renderer\**" />
    </ItemGroup>

</Project>
